# Copy to .env.local for development. Set the production API URL before building.
# Only public configuration belongs in the frontend environment; never secret keys.
NEXT_PUBLIC_CHECKOUT_API_URL=http://localhost:4010

# Optional analytics. Unset/none sends nothing; loads only after entry acceptance.
# PostHog's project ingestion key is public, not a personal/admin API key.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
